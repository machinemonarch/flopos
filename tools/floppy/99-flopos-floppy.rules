# Let the logged-in user write to a USB floppy drive without root.
#
# Typing a password every time a 1.44MB disk is written gets old within
# about three disks, and the alternative -- a passwordless sudo entry --
# hands out root to get at a device that holds 1.4 megabytes.  This hands
# out the device instead, which is the thing actually wanted.
#
# The match is deliberately narrow: a removable USB block device whose
# whole capacity is 2880 sectors.  Nothing but a 1.44MB floppy is 2880
# sectors, so this cannot widen to anything that matters.
#
# TAG+="uaccess" gives it to whoever is logged in at the machine, which
# systemd-logind maintains, rather than to a group that persists whether
# anybody is sitting there or not.
#
# Install:
#     sudo cp tools/floppy/99-flopos-floppy.rules /etc/udev/rules.d/
#     sudo udevadm control --reload
# then unplug the drive and plug it back in.

SUBSYSTEM=="block", KERNEL=="sd[a-z]", SUBSYSTEMS=="usb", \
  ATTR{removable}=="1", ATTR{size}=="2880", \
  TAG+="uaccess", MODE="0660", GROUP="disk"
