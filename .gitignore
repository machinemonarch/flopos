# Build output, reproducible from source: build/ is everything compiled
# (the tests' too), dist/ the finished floppy image.
/build/
/dist/

# Released floppy images: 1.4MB each, and any of them can be rebuilt by
# checking out the matching commit and running `make`.
releases/

# Vendor documentation and third-party binaries used for reference only.
# Toshiba's manuals and driver CDs are theirs, not part of this project,
# and must not be redistributed with it. Nothing in here is built against
# or copied from -- it is read to learn facts about the hardware.
reference/

# Photographs dropped in to be turned into a boot picture. The pictures
# made from them (data/*.pix) are committed, so the build does not need
# these; only making them again does.
photos/

*.ppm
*.o
*.bin
*.img

# Not part of the project: shell and editor configuration that happens to
# sit in this directory, and which the sandbox presents as character
# devices that git cannot add in any case.
.bash_profile
.bashrc
.gitconfig
.gitmodules
.profile
.ripgreprc
.zprofile
.zshrc
.mcp.json
.idea
.vscode
.claude/
logs/
